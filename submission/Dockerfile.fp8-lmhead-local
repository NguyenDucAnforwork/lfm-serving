# FP8 baseline plus runtime FP8 LM-head copy for LFM2.5-1.2B-Instruct.
#
# Build context must be the repository root:
#   docker build -f submission/Dockerfile.fp8-lmhead-local -t <image>:<tag> .
#
# Before building, copy/sync the official BF16 checkpoint into:
#   submission/model/
FROM vllm/vllm-openai:v0.22.1

RUN pip install --no-cache-dir xxhash

COPY patches/apply_vllm_lfm2_fp8_lm_head.py /tmp/apply_vllm_lfm2_fp8_lm_head.py
RUN python3 /tmp/apply_vllm_lfm2_fp8_lm_head.py && rm /tmp/apply_vllm_lfm2_fp8_lm_head.py

COPY submission/model /model

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    VLLM_NO_USAGE_STATS=1 \
    DO_NOT_TRACK=1 \
    LFM2_FP8_LM_HEAD=1

EXPOSE 8000
