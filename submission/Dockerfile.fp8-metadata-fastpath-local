# FP8 submission image with local vLLM decode metadata fast-path patch.
#
# Build context must be the repository root:
#   docker build -f submission/Dockerfile.fp8-metadata-fastpath-local -t <image>:<tag> .
#
# Before building, copy/sync the official BF16 checkpoint into:
#   submission/model/
FROM vllm/vllm-openai:v0.22.1

RUN pip install --no-cache-dir xxhash

COPY patches/apply_vllm_decode_metadata_fastpath.py /tmp/apply_vllm_decode_metadata_fastpath.py
RUN python3 /tmp/apply_vllm_decode_metadata_fastpath.py && rm /tmp/apply_vllm_decode_metadata_fastpath.py

COPY submission/model /model

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    VLLM_NO_USAGE_STATS=1 \
    DO_NOT_TRACK=1

EXPOSE 8000
