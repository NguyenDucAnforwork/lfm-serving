MODEL=LiquidAI/LFM2.5-1.2B-Instruct
SERVED_MODEL_NAME=LFM2.5-1.2B-Instruct
HOST=127.0.0.1
PORT=8000
MAX_MODEL_LEN=5120
GPU_MEM_UTIL=0.22
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=512
ENABLE_PREFIX_CACHING=1
ENABLE_CHUNKED_PREFILL=
QUANTIZATION=fp8_per_tensor
PREFIX_CACHE_HASH_ALGO=xxhash
DISABLE_LOG_STATS=1
DISABLE_ACCESS_LOG=1
# Same runtime flags as fp8_h200shape.env, but VRAM_LIMIT_MIB raised for this
# box's actual GPU (RTX PRO 6000 Blackwell, 97GB) -- gpu_memory_utilization
# is a FRACTION of total memory, so 0.22 here reserves ~21.5GB pool, not the
# ~5.4GB it reserved on the original 24GB dev card. 7000 MiB would trip the
# vram_monitor.sh safety kill immediately on this hardware.
VRAM_LIMIT_MIB=30000
