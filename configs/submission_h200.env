# H200 submission profile candidate. UNTESTED on real H200 hardware -- this
# repo only has access to a shared RTX 3090. Every value that differs from
# the RTX-3090-validated best.env is flagged ASSUMPTION below with the
# reasoning; see EXPERIMENTS.md "H200 submission profile" and "Session 2"
# for full writeup. Do not treat this as equivalent-confidence to best.env.
#
# UPDATED (session 2, 2026-07-17/18): now includes fp8_per_tensor online
# quantization (T1) -- MEASURED +9.3 to +9.9pp ERS (55.18%->64.4-65.3% across
# tested shapes; 65.07/64.81/65.29% mean ~65.1% on this exact H200-shaped
# config), TPOT mean cut ~30% (4.09ms->2.85ms), on THIS Ampere GPU via Marlin
# W8A16 fallback -- H200's native Hopper W8A8 kernels should do at least as
# well. FULLY CLEARED on accuracy: zero measurable degradation across FOUR
# independent checks -- arc_challenge, gsm8k, a 198-question GPQA-diamond-mc
# ungated-mirror check, and (once the HF_TOKEN's account accepted
# Idavidrein/gpqa's access terms mid-session) **the literal official
# gpqa_diamond_zeroshot lm_eval task on the literal gated dataset itself**:
# 0.2222->0.2323, Delta=-0.010 (FP8 slightly higher), 0.24 combined SE from
# zero -- ~1/10th of the official 0.10 threshold (see EXPERIMENTS.md
# "official GPQA-diamond access granted"). This is the single highest-ROI
# change in the whole project, and it is now the most rigorously validated
# one too; everything below it was already true in session 1.

MODEL=/model
# ASSUMPTION: served name must match the spec exactly; without this, vLLM
# would advertise the model as the literal path "/model" (see start_server.sh
# fix -- --served-model-name was previously never passed).
SERVED_MODEL_NAME=LFM2.5-1.2B-Instruct
HOST=0.0.0.0
PORT=8000

# MEASURED (session 2): fp8_per_tensor is vLLM 0.22.1's newer online-quant
# framework. CRITICAL: do NOT use the legacy `--quantization fp8` name --
# it loads without error but produces GIBBERISH output on this model (root
# cause not fully isolated; something in the legacy Fp8Config path breaks
# for LFM2's hybrid conv/attention layers). fp8_per_tensor uses the same
# Marlin W8A16 kernel on this Ampere GPU but is fully coherent.
QUANTIZATION=fp8_per_tensor

# ASSUMPTION: bumped from the RTX-3090-validated 4608 to 5120 purely for
# extra safety margin (the public trace never exceeds ~4200 effective
# tokens, but the hidden trace is unseen). Dev experiments showed 4352 vs
# 4608 vs 5120 are ERS-equivalent on the 3090, so this should be a free
# safety margin, not a performance change -- but that equivalence itself
# hasn't been checked on H200/Hopper.
MAX_MODEL_LEN=5120

# ASSUMPTION (still the least certain value in this file, though partially
# de-risked by fp8 -- see below). Naively copying 0.22 from the shared 24GB
# 3090 would target only ~4GB of the H200's 18GB -- wasteful, since the MIG
# slice is dedicated (no other tenant can use the rest, unlike our dev box).
#
# BACKGROUND INCIDENT (session 1): raising max_num_seqs (4->8) and
# max_model_len (4608->5120) *together* was tested on the 3090 at BF16 with
# gpu_memory_utilization=0.22, expecting ~5.3GB target usage. Actual peak was
# 7236 MiB -- 37% over the naive target and over this project's own 7168 MiB
# (7GB) hard limit; the test server was stopped immediately. Root cause not
# fully isolated (plausibly CUDA-graph/activation buffer sizing scaling with
# both dimensions at once, not independently).
#
# UPDATE (session 2): re-tested the EXACT same max_num_seqs=8 +
# max_model_len=5120 combination, this time WITH fp8_per_tensor, still at
# gpu_memory_utilization=0.22. Peak VRAM: 5628-5636 MiB (2 clean runs) --
# comfortably under the old 7236 MiB incident and under the 7GB local limit.
# FP8's ~1GB smaller weights fully absorbed the earlier interaction effect
# on this hardware. This is reassuring but NOT the same as proving the
# interaction effect is zero on H200 -- it might reappear at higher
# gpu_memory_utilization (0.70 targets much more absolute memory than 0.22
# did). 0.70 (not the initially-considered 0.78) still targets ~12.6GB,
# leaving ~5.4GB (30%) headroom -- kept deliberately conservative.
# Recommended next action: validate with a real nvidia-smi/nvidia-ml reading
# on the target hardware before submitting, and adjust down if peak VRAM
# isn't comfortably under 18GB.
GPU_MEM_UTIL=0.70

# ASSUMPTION: raised from the RTX-3090-validated 4 to 8 as a concurrency
# safety margin. On the 3090, max_num_seqs=4/8/16 were empirically
# equivalent (~41% ERS at the old batchtok setting) because true concurrency
# in this trace rarely exceeds single digits (measured peak=7, time-avg=1.17
# -- see EXPERIMENTS.md). 8 costs nothing if the hidden trace has similar
# concurrency, and gives headroom if it's burstier than the public sample.
# CONFIRMED (session 2): with fp8 + this exact value, full-trace ERS was
# 64.8-65.1% (2 clean runs, 0.26pp spread) -- no regression from raising
# max_num_seqs to 8.
MAX_NUM_SEQS=8

# ASSUMPTION (second most uncertain value here): 256 was the RTX-3090 sweet
# spot (BF16) because it balances (a) large prefill chunks stalling
# concurrent decode steps against (b) per-step Python/scheduling overhead
# when chunks are too small. Effect (a)'s cost scales with how long a chunk
# takes to compute -- on H200's much higher compute throughput, the SAME
# token count finishes faster, so the "too large" threshold should sit
# higher than on a 3090; effect (b)'s cost is roughly fixed (CPU-bound
# control-plane overhead), so the "too small" threshold shouldn't move much.
# Net prediction: the sweet spot shifts up. 512 is a hedge, not a
# measurement -- CONFIRMED NOT TO HURT with fp8 on this GPU (session 2: ERS
# 64.8-65.1%, on par with fp8+batchtok=256's 64.4-64.9%), but the narrow
# 192-384 sweep (session 2) was defeated by shared-tenant contention on this
# box (see EXPERIMENTS.md "Narrow sweep"), so 512 vs other nearby values on
# H200 specifically remains a genuine open question.
# Recommended next action: run a 256/512/1024 sweep directly on H200 before
# finalizing (this is now the single most valuable remaining unknown).
MAX_NUM_BATCHED_TOKENS=512

ENABLE_PREFIX_CACHING=1
ENABLE_CHUNKED_PREFILL=

# MEASURED (session 2, under simulated 3-CPU-core pinning via `taskset`):
# xxhash + logs-off together gave a small but consistent positive signal
# (cpu3_opt 55.56% vs cpu3_base 54.88% at BF16, +0.68pp) and RSS was
# unaffected (2.96GB either way, well under the 8GB grading limit).
# CRITICAL DEPENDENCY: xxhash requires the `xxhash` Python package, which is
# NOT installed by default -- without it, every request 500s
# (ModuleNotFoundError). The Dockerfile installs it explicitly
# (`RUN pip install --no-cache-dir xxhash`) -- do not remove that line.
PREFIX_CACHE_HASH_ALGO=xxhash
DISABLE_LOG_STATS=1
DISABLE_ACCESS_LOG=1

# REJECTED, not included: --spec-method ngram (or ngram_gpu/suffix) caused a
# hard CUDA crash ("illegal memory access") under real concurrent load in
# BOTH bf16 and fp8 configurations (session 2, T6) -- architectural
# incompatibility with LFM2's hybrid conv/mamba layers. Do not enable any
# speculative decoding method for this model.
# REJECTED, not included: --max-num-partial-prefills 2 -- vLLM refuses at
# config-validation time ("Concurrent Partial Prefill is not supported").
# REJECTED, not included: --block-size 32 -- measured 1.7pp worse than the
# default 16 (reduces prefix-cache hit granularity for this workload's long
# shared prefixes).

# Informational only in this profile (no watchdog process ships in the
# submission container/compose by default -- see docker-compose.submit.yml).
# 18GB MiG slice; keep a real margin below it.
VRAM_LIMIT_MIB=16384
