# Local-only legacy FP8 diagnostic for vLLM 0.10.0+cu126.
# This is deliberately NOT the official fp8_per_tensor baseline and must not be
# submitted; prior repo evidence says legacy --quantization=fp8 can produce
# incoherent output on LFM2.
MODEL=LiquidAI/LFM2.5-1.2B-Instruct
HOST=127.0.0.1
PORT=8000
SERVED_MODEL_NAME=LFM2.5-1.2B-Instruct
MAX_MODEL_LEN=5120
GPU_MEM_UTIL=0.70
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=512
ENABLE_PREFIX_CACHING=1
ENABLE_CHUNKED_PREFILL=
PREFIX_CACHE_HASH_ALGO=
DISABLE_LOG_STATS=1
DISABLE_ACCESS_LOG=1
QUANTIZATION=fp8
VRAM_LIMIT_MIB=22000
